<Page
    x:Class="AutoPointUA.Views.GaragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Style="{StaticResource PageStyle}"
    mc:Ignorable="d">

    <Grid x:Name="ContentArea" Margin="20">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
            <!-- Карточка Audi -->
            <Border BorderThickness="1" BorderBrush="Gray" Padding="10" Background="Yellow" Height="420" Width="200">
                <StackPanel Margin="5">
                    <Image Source="/Assets/Cars/Audi1.png" Height="150" Stretch="Uniform" />
                    <TextBlock Text="Бренд: Audi" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Назва: A6" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Рік: 2023" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Пробіг, км: 5000" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Колір: білий" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Тип приводу: повний" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Статус: не у продажу" Foreground="Red" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <Button Content="Переглянути" Margin="0,5,0,0" Click="NavigateAudiViewPage" />
                </StackPanel>
            </Border>

            <!-- Карточка Tesla -->
            <Border BorderThickness="1" BorderBrush="Gray" Padding="10" Background="Yellow" Height="420" Width="200">
                <StackPanel Margin="5">
                    <Image Source="/Assets/Cars/Tesla1.png" Height="150" Stretch="Uniform" />
                    <TextBlock Text="Бренд: Tesla" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Назва: Model 3" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Рік: 2023" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Пробіг, км: 100" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Колір: чорний" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Тип приводу: задній" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Статус: не у продажу" Foreground="Red" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <Button Content="Переглянути" Margin="0,5,0,0" Click="NavigateTeslaViewPage" />
                    </StackPanel>
            </Border>

            <!-- Карточка BMW -->
            <Border BorderThickness="1" BorderBrush="Gray" Padding="10" Background="Yellow" Height="420" Width="200">
                <StackPanel Margin="5">
                    <Image Source="/Assets/Cars/BMW1.png" Height="150" Stretch="Uniform" />
                    <TextBlock Text="Бренд: BMW" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Назва: X5" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Рік: 2021" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Пробіг, км: 30000" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Колір: чорний" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Тип приводу: повний" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Статус: не у продажу" Foreground="Red" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <Button Content="Переглянути" Margin="0,5,0,0" Command="{Binding SelectCommand}" />
                </StackPanel>
            </Border>

            <!-- Карточка Toyota -->
            <Border BorderThickness="1" BorderBrush="Gray" Padding="10" Background="Yellow" Height="420" Width="200">
                <StackPanel Margin="5">
                    <Image Source="/Assets/Cars/Toyota1.png" Height="150" Stretch="Uniform" />
                    <TextBlock Text="Бренд: Toyota" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Назва: RAV4" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Рік: 2020" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Пробіг, км: 40000" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Колір: синій" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Тип приводу: повний" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                        <TextBlock Text="Статус: не у продажу" Foreground="Red" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
                        <Button Content="Переглянути" Margin="0,5,0,0" Command="{Binding SelectCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>

</Page>
